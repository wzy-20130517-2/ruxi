<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（API 26+）。

  ⚠️ 这里指向的是 **mipmap** 下的 PNG，不是 drawable 下的 vector。
  之前误指向 @drawable/ic_launcher_foreground（那是早期手写的 vector 版），
  结果在支持自适应图标的设备上显示的是旧图标、在不支持的设备上显示新 PNG ——
  两套图标并存，改了一套另一套没变。

  现在统一：图标全部由 tools/make_icon.py 生成 PNG，
  drawable/ 下的 vector 版本已删除。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
